<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Description>Options, catalog and contracts for the ZakBlazorTransition engine (no web dependencies).</Description>
    <Authors>ZakBlazorTransition</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;transitions;animation</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/zakspace/zakblazortransition</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zakspace/zakblazortransition</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Package icon shipped at the package root. -->
  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
