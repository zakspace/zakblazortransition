<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Page transitions for Blazor: the ZakBlazorTransition engine (GSAP + optional WebGL) driving real route navigations.</Description>
    <Version>1.0.0</Version>
    <Authors>ZakBlazorTransition</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;transitions;animation;gsap;webgl</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/zakspace/zakblazortransition</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zakspace/zakblazortransition</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZakBlazorTransition.Core\ZakBlazorTransition.Core.csproj" />
  </ItemGroup>

  <!-- Package icon: ship the PNG at the package root; keep the SVG source in-repo only. -->
  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include="icon.svg" Pack="false" />
  </ItemGroup>

  <!-- Package README (shown on nuget.org); kept out of the default content glob. -->
  <ItemGroup>
    <Content Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
